{
  "name": "bivyswiss",
  "version": "0.1.0",
  "private": true,
  "description": "BivySwiss : randonnée et bivouac en Suisse",
  "workspaces": ["server", "client"],
  "scripts": {
    "db": "bash scripts/startDb.sh",
    "db:stop": "bash scripts/stopDb.sh",
    "seed": "npm run seed --workspace server",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "dev": "npm run db && (npm run dev:server & npm run dev:client & wait)",
    "test": "npm test --workspace server"
  }
}
