# Copie ce fichier en .env (non versionné) puis remplis les valeurs.

# Serveur
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# MongoDB de développement (lancée par `npm run db`)
MONGODB_URI=mongodb://127.0.0.1:27017/bivyswiss

# Cache des cartes swisstopo
TILE_CACHE_DIR=./data/tiles

# Authentification (préparée, pas encore active)
JWT_SECRET=change-moi-avec-une-longue-chaine-aleatoire
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
